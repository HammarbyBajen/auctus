# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgres://user:password@localhost:5432/tegen_crm
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Used only by `pnpm db:seed` to create the first owner.
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=

# Mana studio API key (read-only use, background jobs only).
MANA_API_KEY=

# Secret that Vercel Cron sends when it calls /api/cron/mana-sync. Any long random value.
CRON_SECRET=

# The studio's id in Mana (not secret). `pnpm db:seed` stores it in the studio settings.
MANA_STUDIO_ID=
